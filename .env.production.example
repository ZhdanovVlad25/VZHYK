# ВЖИК — Production Environment Example (docker-compose.prod.yml)
# Скопіюйте у .env.production (в git не потрапляє, див. .gitignore) і заповніть
# реальними значеннями. Ніколи не комітьте .env.production з реальними секретами —
# у реальному продакшні ці значення мають жити в secret manager (docs/deployment.md §8),
# цей файл — лише зручність для self-hosted docker-compose.prod.yml деплою.

# --- General ---
NODE_ENV=production
# Публічний origin фронтенду — звужує CORS на бекенді (main.ts) І редіректить сюди
# після Google OAuth callback. Обов'язково реальний домен, інакше API не стартує.
WEB_ORIGIN=https://vzhyk.example
NEXT_PUBLIC_SITE_URL=https://vzhyk.example
NEXT_PUBLIC_API_URL=https://api.vzhyk.example/api/v1

# --- Database (docker-compose.prod.yml підставляє ці значення в DATABASE_URL сам) ---
POSTGRES_USER=vzhyk
POSTGRES_PASSWORD=change_me_strong_random_password
POSTGRES_DB=vzhyk
DATABASE_SSL=false

# --- Object Storage — self-hosted MinIO (docker-compose.prod.yml) або хмарний S3 ---
# Для хмарного S3: замініть S3_ENDPOINT на реальний хост і приберіть сервіс minio
# з docker-compose.prod.yml.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vzhyk-media
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_strong_random_secret
S3_FORCE_PATH_STYLE=true

# --- Auth: JWT — обов'язково змінити, довгі випадкові рядки (openssl rand -hex 32) ---
# Обов'язковий: без JWT_ACCESS_SECRET застосунок не стартує (fail fast, apps/api/src/shared/env.ts).
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_TTL=15m
# JWT_REFRESH_SECRET наразі не використовується окремо — див. коментар у .env.example.
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_TTL=30d
JWT_KID=prod-key-1

# --- Auth: Phone OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_PHONE_15MIN=3
OTP_REQUEST_LIMIT_PER_IP_HOUR=10
SMS_PROVIDER=twilio # console у продакшні НЕ використовувати — коди логуються у stdout

# --- Auth: Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.vzhyk.example/api/v1/auth/google/callback

# --- Business settings defaults ---
LISTING_MAX_ACTIVE_PER_USER=5
PII_RETENTION_MONTHS=6

# --- Error tracking (Sentry) — опційно, без DSN нічого не робить ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Backups (scripts/backup-db.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
