# ВЖИК — Environment Configuration Example
# Скопіюйте у .env та заповніть реальними значеннями для локальної розробки.
# Ніколи не комітьте .env з реальними секретами.

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://vzhyk:vzhyk_dev_password@localhost:5432/vzhyk
DATABASE_SSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (S3-compatible / MinIO for dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vzhyk-media
S3_ACCESS_KEY=vzhyk_minio
S3_SECRET_KEY=vzhyk_minio_password
S3_FORCE_PATH_STYLE=true

# --- Auth: JWT ---
JWT_ACCESS_SECRET=change_me_dev_only_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret
JWT_REFRESH_TTL=30d
JWT_KID=dev-key-1

# --- Auth: Phone OTP (SMS provider — заглушка на Phase 1, реальний провайдер підключається пізніше) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_PHONE_15MIN=3
OTP_REQUEST_LIMIT_PER_IP_HOUR=10
SMS_PROVIDER=console # console (лог у stdout, dev-режим) | twilio | turbosms

# --- Auth: Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- Business settings defaults (seed для app_settings, редаговані з Admin Panel) ---
LISTING_MAX_ACTIVE_PER_USER=5
PII_RETENTION_MONTHS=6

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
