# ВЖИК — Environment Configuration Example
# Скопіюйте у .env та заповніть реальними значеннями для локальної розробки.
# Ніколи не комітьте .env з реальними секретами.

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://vzhyk:vzhyk_dev_password@localhost:5432/vzhyk
DATABASE_SSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (S3-compatible / MinIO for dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vzhyk-media
S3_ACCESS_KEY=vzhyk_minio
S3_SECRET_KEY=vzhyk_minio_password
S3_FORCE_PATH_STYLE=true

# --- Auth: JWT ---
JWT_ACCESS_SECRET=change_me_dev_only_access_secret
JWT_ACCESS_TTL=15m
# JWT_REFRESH_SECRET/_TTL: задекларовано на майбутнє, коли з'явиться POST /auth/refresh.
# Зараз AuthService.issueTokens() підписує і access, і refresh одним і тим самим
# JwtService/JWT_ACCESS_SECRET (лише з різним expiresIn) — refresh-токен видається,
# але ніде не приймається назад (Phase 8 security review, docs/deployment.md §8).
JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret
JWT_REFRESH_TTL=30d
JWT_KID=dev-key-1

# --- Auth: Phone OTP (SMS provider — заглушка на Phase 1, реальний провайдер підключається пізніше) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_PHONE_15MIN=3
OTP_REQUEST_LIMIT_PER_IP_HOUR=10
SMS_PROVIDER=console # console (лог у stdout, dev-режим) | twilio | turbosms
# Опційно: сталий OTP-код для одного номера, щоб не ганятись за console.log при
# ручному тестуванні. Діє лише коли NODE_ENV != production (auth.service.ts
# requestOtp()). Порожньо за замовчуванням — заповніть локально в .env.
DEV_FIXED_OTP_PHONE=
DEV_FIXED_OTP_CODE=

# --- Auth: Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
# Куди редіректити браузер після google/callback з токенами в query — apps/web origin.
WEB_ORIGIN=http://localhost:3000

# --- Business settings defaults (seed для app_settings, редаговані з Admin Panel) ---
LISTING_MAX_ACTIVE_PER_USER=5
PII_RETENTION_MONTHS=6

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Error tracking (Sentry) — опційно, без DSN нічого не робить (no-op). Phase 8. ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
